{
    "version": 2,
    "env": {
        "NODE_ENV": "production"
    },
    "builds": [
        {
            "src": "server-static.js",
            "use": "@vercel/node@^2.12.0"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server-static.js"
        }
    ]
}